NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DB_DRIVER=sqlite
# Development only. Production requires MySQL and durable private file storage.
DATA_DIR=./data
DB_HOST=localhost
DB_SOCKET_PATH=/var/lib/mysql/mysql.sock
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
# Emergency uptime fallback: keep true until MySQL credentials are repaired.
DB_ALLOW_SQLITE_FALLBACK=true
# Set both only for the first production start, then remove them after signing in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional SMS phone verification; without these values SMS stays unavailable.
# WhatsApp recovery also needs a BYO WhatsApp sender linked to this Verify Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional transactional SMS for order receipts and status updates.
# Keep disabled until an approved sender or Messaging Service is configured.
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_MESSAGING_SERVICE_SID=
# Alternative to TWILIO_MESSAGING_SERVICE_SID. May be an approved long code or sender ID.
TWILIO_SMS_FROM=
RECOVERY_WHATSAPP_ENABLED=false
# Meta callbacks only. Keep disabled until secrets are saved privately and Meta verifies subscription.
# Configure the TEST account first; this does not enable outbound messages or recovery.
META_WEBHOOK_ENABLED=false
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
# Mubasat / EdfaPay hosted checkout.
# Production is enabled automatically when EDFAPAY_API_KEY exists unless explicitly set to false.
# API keys and webhook secrets belong only in the private server environment.
EDFAPAY_CHECKOUT_ENABLED=
EDFAPAY_API_KEY=
# Sandbox-only aliases are also accepted by the runtime. When only the sandbox key is set,
# the hosted checkout defaults to https://demo-api.edfapay.com/api/v1/payment-gateway/initiate.
EDFAPAY_SANDBOX_API_KEY=
EDFAPAY_SANDBOX_INITIATE_URL=
# Production endpoint shown below; use the sandbox endpoint supplied by EdfaPay while testing.
EDFAPAY_INITIATE_URL=https://app-api.edfapay.com/api/v1/payment-gateway/initiate
# Signed webhook is preferred. Configure the same secret in the EdfaPay dashboard.
EDFAPAY_WEBHOOK_ENABLED=false
EDFAPAY_WEBHOOK_SECRET=
# Legacy callback-token fallback only when no webhook secret is configured.
EDFAPAY_CALLBACK_TOKEN=
# Merchant hosted checkout is preferred when merchant credentials are configured.
# To explicitly select the newer X-API-KEY integration, use api_key.
EDFAPAY_INTEGRATION=
# Explicit false disables merchant checkout; set true to enable it.
EDFAPAY_MERCHANT_ID=
EDFAPAY_MERCHANT_PASSWORD=
# Set after confirming the public business email.
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Direct WhatsApp contact is separate from automated recovery. Digits only.
BUSINESS_WHATSAPP_PHONE=966553575760
# Private contract provider settings. Complete verified details in deployment only.
# Types: none, commercial_registration, freelance_certificate; a certificate is not a CR.
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_REGISTRATION_TYPE=none
BUSINESS_ACTIVITY=
# Optional password recovery email; keep disabled until configuration and delivery tests pass.
# Requires APP_URL with HTTPS, valid sender, SMTP credentials, and successful SMTP verification.
# Port 587 uses required STARTTLS with secure=false; port 465 requires secure=true.
RECOVERY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RECOVERY_FROM_EMAIL=
# Exact IP addresses of trusted reverse proxies; never use a wildcard.
TRUSTED_PROXY_IPS=
# Free guided assistant is the default; it uses the public catalog and makes no AI API calls.
ASSISTANT_MODE=guided
# Optional generative mode requires explicit ASSISTANT_MODE=openai and private credentials.
# Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Google Analytics 4 public measurement ID (not an API secret).
# Analytics loads only after the visitor accepts analytics and only on public routes.
GOOGLE_ANALYTICS_ID=
# Optional OpenAI mode: maximum requests per UTC day per server process; set provider spending limits too.
ASSISTANT_DAILY_LIMIT=100
