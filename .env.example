NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DB_DRIVER=sqlite
# Development only. Production requires MySQL and durable private file storage.
DATA_DIR=./data
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
# Set both only for the first production start, then remove them after signing in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional phone verification; without these values SMS stays unavailable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Set after confirming the public business email.
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Exact IP addresses of trusted reverse proxies; never use a wildcard.
TRUSTED_PROXY_IPS=
# Optional: real AI assistant, server-side only. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Google Analytics 4 public measurement ID (not an API secret).
# Analytics loads only after the visitor accepts analytics and only on public routes.
GOOGLE_ANALYTICS_ID=
# Maximum requests per UTC day per server process; also set provider spending limits.
ASSISTANT_DAILY_LIMIT=100
