{
  "name": "antlaqh-platform",
  "version": "5.4.0",
  "private": true,
  "description": "منصة انطلاقة للخدمات والمنتجات الرقمية",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
